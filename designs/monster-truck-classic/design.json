  "steps": [
    {
      "title": "Print, tape and trace",
      "figures": [
        {
          "refPart": "chassis-core",
          "caption": "Chassis Core — trace this 24 times. Yes, 24!"
        }
      ],
      "instructions": [
        "Print at 100% actual size and tape the pages together on the grid lines.",
        "Trace 24 Chassis Cores, 2 Truck Sides, 1 Hood + Roof Wrap, 1 Bed Floor, 1 Tailgate, 36 Wheel Discs and 4 Wheel Face Rings.",
        "Line the corrugation arrow up with the flutes inside the cardboard every time."
      ],
      "tip": "Cut ONE Chassis Core first, then use it as a stencil for the other 23 — much faster than tracing."
    },
    {
      "title": "Cut, score and punch",
      "figures": [
        {
          "refPart": "truck-side",
          "caption": "Truck Side — window and arches cut out, tab legs left on."
        }
      ],
      "instructions": [
        "Grown-up job: cut every solid line with a sharp knife and metal ruler, in 2-3 light passes.",
        "Score the two dashed lines on the Wrap and the dashed tread lines on the wheels HALF-deep only — never cut through.",
        "Grown-up job: punch the 5/16-inch axle holes in all 24 cores and both sides, and the small centre hole in all 36 discs."
      ]
    },
    {
      "title": "Stack the 24-layer chassis core",
      "figures": [
        {
          "refPart": "chassis-core",
          "caption": "Chassis Core ×24 — glued into one 3.6-inch-thick chassis."
        }
      ],
      "instructions": [
        "Slide both dowels through two cores to line the axle tunnels up perfectly, then glue those two face to face.",
        "Keep adding glued layers down the dowels until all 24 are stacked — spread glue right to the edges.",
        "Slide the dowels back out and press the chassis flat under books overnight."
      ],
      "tip": "Wood glue is far stronger than hot glue here — the overnight wait is worth it."
    },
    {
      "title": "Hang the sides on the chassis",
      "figures": [
        {
          "refPart": "truck-side",
          "caption": "Truck Side ×2 — tab-leg holes lined up with the axle tunnels."
        }
      ],
      "instructions": [
        "Slide the dowels through the chassis again and thread a Truck Side onto each end so every tab hole lines up.",
        "Glue each side to the core face: bed wall against the floor platform, nose edge flush with the core nose.",
        "The tab legs sandwich the core at the axles — clamp them flat while the glue grabs."
      ]
    },
    {
      "title": "Bed floor, tailgate and the hood wrap",
      "figures": [
        {
          "refPart": "hood-wrap",
          "caption": "Hood + Roof Wrap — crease at the two score lines."
        }
      ],
      "instructions": [
        "Drop the Bed Floor onto the chassis platform between the sides and glue it — the bed stays OPEN for cargo.",
        "Glue the Tailgate across the back of the bed, tucked between the two sides.",
        "Crease the Wrap at both score lines, then glue it on: roof first, windshield leaning back, hood meeting the nose."
      ],
      "tip": "Crease the wrap over a table edge for two dead-straight bends."
    },
    {
      "title": "Build four fat wheels",
      "figures": [
        {
          "refPart": "wheel-disc",
          "caption": "Wheel Disc ×36 — nine discs make one 1.35-inch-thick wheel."
        }
      ],
      "instructions": [
        "Thread 9 Wheel Discs onto a spare dowel so the hub holes line up, gluing each disc to the next.",
        "Glue a Wheel Face Ring on the outside of each stack for the recessed-hub look.",
        "Make four wheels, slide them off the dowel and let them dry."
      ],
      "tip": "Sand around each rim so the wheels roll round instead of lumpy."
    },
    {
      "title": "Fit the axles and go",
      "figures": [
        {
          "refPart": "wheel-face",
          "caption": "Wheel Face ×4 — dowel ends sit inside the recessed hubs."
        }
      ],
      "instructions": [
        "Push one dowel through each axle line: tab, core tunnel, tab — it must spin freely the whole way.",
        "Grown-up job: glue the DOWEL ENDS only, then press a wheel onto each end. Never glue inside the tunnels.",
        "Leave a dime of daylight between wheels and tabs, let it dry, then load the bed and race it."
      ]
    }
  ],
