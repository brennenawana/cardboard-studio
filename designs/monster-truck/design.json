  "steps": [
    {
      "title": "Print, tape and trace",
      "figures": [
        {
          "refPart": "body-core",
          "caption": "Truck Body Core — trace this 24 times. Yes, 24!"
        }
      ],
      "instructions": [
        "Print at 100% actual size and tape the pages together on the grid lines.",
        "Trace 24 Body Cores, 2 Truck Sides, 36 Wheel Discs, 4 Wheel Faces, 2 Bumper Plates and 1 Light Bar.",
        "Line the corrugation arrow up with the flutes inside the cardboard every time."
      ],
      "tip": "Cut ONE Body Core first, then use it as a stencil for the other 23 — much faster than tracing."
    },
    {
      "title": "Cut, score and punch the holes",
      "figures": [
        {
          "refPart": "side-skin",
          "caption": "Truck Side — the big wheel arches are cut all the way out."
        }
      ],
      "instructions": [
        "Grown-up job: cut every solid line with a sharp knife and a metal ruler, in 2-3 light passes.",
        "Score the dashed tread lines and grille bars HALF-deep only — never cut through.",
        "Grown-up job: punch the two 5/16-inch axle holes in all 24 Body Cores and the small centre hole in all 36 Wheel Discs."
      ]
    },
    {
      "title": "Stack the 24-layer core",
      "figures": [
        {
          "refPart": "body-core",
          "caption": "Body Core ×24 — glued into one 3.6-inch-thick slab."
        }
      ],
      "instructions": [
        "Slide both dowels through two Body Cores to line them up perfectly, then glue those two face to face.",
        "Keep adding glued layers down the dowels until all 24 are stacked, spreading glue right to the edges.",
        "Slide the dowels back out and press the slab flat under books overnight."
      ],
      "tip": "Wood glue is far stronger than hot glue here — the overnight wait is worth it."
    },
    {
      "title": "Skin the sides, add bumpers and lights",
      "figures": [
        {
          "refPart": "side-skin",
          "caption": "Truck Side ×2 — one per face, arches centred on the axle tunnels."
        }
      ],
      "instructions": [
        "Glue a Truck Side onto each face of the slab, matching the outline and centring each arch on an axle tunnel.",
        "Glue a Bumper Plate across the nose and another across the tail, grille bars facing out.",
        "Glue the Light Bar across the roof behind the windscreen."
      ]
    },
    {
      "title": "Build four fat wheels",
      "figures": [
        {
          "refPart": "wheel-disc",
          "caption": "Wheel Disc ×36 — nine discs make one 1.35-inch-thick wheel."
        }
      ],
      "instructions": [
        "Thread 9 Wheel Discs onto a spare dowel so the hub holes line up, gluing each disc to the next.",
        "Glue a Wheel Face ring on the outside of each stack for the recessed-hub look.",
        "Make four wheels, slide them off the dowel and let them dry."
      ],
      "tip": "Sand around each rim so the wheels roll round instead of lumpy."
    },
    {
      "title": "Fit the axles and go",
      "figures": [
        {
          "refPart": "wheel-face",
          "caption": "Wheel Face ×4 — the outer ring of each finished wheel."
        }
      ],
      "instructions": [
        "Push one dowel through the front tunnel and one through the rear — they must spin freely inside the body.",
        "Grown-up job: glue the DOWEL ENDS only, then press a wheel onto each end. Never glue inside the tunnels.",
        "Leave a dime's thickness of daylight between each wheel and the truck side, dry it, then paint flames and race it."
      ]
    }
  ],
