              "d": "M 0.6 0.25 C 0.79 0.25 0.95 0.41 0.95 0.6 C 0.95 0.79 0.79 0.95 0.6 0.95 C 0.41 0.95 0.25 0.79 0.25 0.6 C 0.25 0.41 0.41 0.25 0.6 0.25 Z",
