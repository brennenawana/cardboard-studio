  "steps": [
    {
      "title": "Print, tape and trace",
      "figures": [
        {
          "refPart": "chest-body",
          "caption": "The Chest Box — one big cross shape that folds into the whole box."
        },
        {
          "refPart": "lid-end",
          "caption": "The Lid Arch End — trace this twice."
        }
      ],
      "instructions": [
        "Print the template at 100% actual size and tape the pages together using the grid.",
        "Trace the Chest Box ONCE, the Lid Arch End TWICE, the Lid Wrap ONCE, the Hasp Strap ONCE and the Lock Button TWICE onto cardboard.",
        "Keep the corrugation arrows lined up with the little waves inside the cardboard.",
        "Poke a pencil dot through the ends of every dashed line so you can draw the fold lines on your cardboard too."
      ],
      "tip": "Trace on the plain side of the cardboard so pencil lines are easy to see."
    },
    {
      "title": "Cut out the parts",
      "figures": [
        {
          "refPart": "lid-wrap",
          "caption": "The Lid Wrap — cut the outline only. The dashed lines get scored, not cut."
        }
      ],
      "instructions": [
        "Grown-up job: cut along all solid lines with a sharp knife and metal ruler, in 2-3 light passes.",
        "Cut out the round keyhole in the Hasp Strap too.",
        "Do NOT cut the dashed lines — score them lightly (half-deep) with the knife against the ruler so they fold cleanly.",
        "Kids can help by holding the ruler steady and collecting the offcuts."
      ]
    },
    {
      "title": "Fold and glue the box",
      "figures": [
        {
          "paths": [
            {
              "d": "M 1.0 1.6 L 3.4 1.6 L 3.4 3.2 L 1.0 3.2 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 1.0 1.6 L 1.35 0.7 L 3.75 0.7 L 3.4 1.6 Z",
              "stroke": "kraftEdge",
              "fill": "kraftDark",
              "width": 2
            },
            {
              "d": "M 1.0 1.6 L 0.35 1.0 L 0.35 2.6 L 1.0 3.2 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 4.0 1.2 C 4.35 1.6 4.35 2.2 4.0 2.6 M 3.85 2.4 L 4.0 2.6 L 4.2 2.5",
              "stroke": "black",
              "width": 1.5
            }
          ],
          "caption": "Fold all four walls up along the scored lines, then fold the little tabs in."
        }
      ],
      "instructions": [
        "Crease every scored line by folding it against the edge of a table or ruler.",
        "Fold the four walls up so the pencil lines end up on the inside.",
        "Fold the tabs on the end walls inward and glue them to the inside of the front and back walls.",
        "Hold each corner with clothespins or tape while the glue dries."
      ],
      "tip": "Hot glue is faster here — but that's a grown-up job. Press each corner for 30 seconds."
    },
    {
      "title": "Build the curved lid",
      "figures": [
        {
          "paths": [
            {
              "d": "M 0.3 2.2 C 0.3 0.9 1.15 0.25 2.15 0.25 C 3.15 0.25 4.0 0.9 4.0 2.2 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 0.15 2.05 C 0.35 0.85 1.2 0.12 2.3 0.1 L 3.2 0.1",
              "stroke": "kraftEdge",
              "width": 3
            },
            {
              "d": "M 3.5 0.4 C 3.9 0.7 4.15 1.1 4.25 1.6 M 4.05 1.45 L 4.25 1.6 L 4.32 1.35",
              "stroke": "black",
              "width": 1.5
            }
          ],
          "caption": "The scored Lid Wrap bends over the two arch ends like a barrel top."
        }
      ],
      "instructions": [
        "Gently crease each dashed line on the Lid Wrap so the whole sheet curves like a wave.",
        "Grown-up job: run a line of hot glue along the curved edge of one Lid Arch End.",
        "Starting at a back corner, press the wrap onto the curve a little at a time until you reach the front.",
        "Glue the second arch to the other side, then trim any extra wrap at the front so it's flush."
      ],
      "tip": "Line the arches up flush with the ends of the wrap so the lid is exactly as wide as the box."
    },
    {
      "title": "Hinge the lid",
      "figures": [
        {
          "paths": [
            {
              "d": "M 0.9 1.7 L 3.1 1.7 L 3.1 3.1 L 0.9 3.1 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 0.9 1.7 C 0.9 0.75 1.55 0.3 2.0 0.3 C 2.45 0.3 3.1 0.75 3.1 1.7 Z",
              "stroke": "kraftEdge",
              "fill": "kraftDark",
              "width": 2
            },
            {
              "d": "M 0.75 1.35 L 0.75 2.05",
              "stroke": "black",
              "width": 2.5
            }
          ],
          "caption": "Tape along the back seam — outside AND inside — makes a strong hinge."
        }
      ],
      "instructions": [
        "Set the lid on the box and line up the back edges exactly.",
        "Run one long strip of cloth tape along the back seam on the outside.",
        "Open the lid and run a second strip along the same seam on the inside.",
        "Open and shut it a few times — a good pirate checks the hinge!"
      ],
      "tip": "Cloth tape or duct tape bends thousands of times without tearing — paper tape doesn't."
    },
    {
      "title": "Add the hasp and lock button",
      "figures": [
        {
          "paths": [
            {
              "d": "M 0.5 0.3 L 3.5 0.3 L 3.5 1.0 L 0.5 1.0 Z",
              "stroke": "kraftEdge",
              "fill": "kraftDark",
              "width": 2
            },
            {
              "d": "M 0.5 1.0 L 3.5 1.0 L 3.5 2.8 L 0.5 2.8 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 1.72 0.55 L 2.28 0.55 L 2.28 1.75 C 2.28 2.1 1.72 2.1 1.72 1.75 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            },
            {
              "d": "M 2.0 1.56 C 2.09 1.56 2.16 1.63 2.16 1.72 C 2.16 1.81 2.09 1.88 2.0 1.88 C 1.91 1.88 1.84 1.81 1.84 1.72 C 1.84 1.63 1.91 1.56 2.0 1.56 Z",
              "stroke": "black",
              "width": 1.5
            },
            {
              "d": "M 2.0 2.25 L 2.0 2.6 M 1.88 2.48 L 2.0 2.6 L 2.12 2.48",
              "stroke": "black",
              "width": 1.5
            }
          ],
          "caption": "The hasp folds over the lid edge and its keyhole drops over the button."
        }
      ],
      "instructions": [
        "Glue the two Lock Buttons on top of each other to make one thick button.",
        "Glue the short end of the Hasp Strap (above the dashed line) to the middle of the lid front, so the strap folds down over the edge.",
        "Close the lid, mark where the keyhole lands on the box front, and glue the button right there.",
        "Drop the keyhole over the button to lock your treasure in!"
      ],
      "tip": "The keyhole is a little bigger than the button on purpose — that's what makes it easy to lock and unlock."
    },
    {
      "title": "Decorate like a real pirate chest",
      "figures": [
        {
