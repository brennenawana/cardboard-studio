            {
              "d": "M 1.4 0.15 C 1.59 0.15 1.75 0.31 1.75 0.5 C 1.75 0.69 1.59 0.85 1.4 0.85 C 1.21 0.85 1.05 0.69 1.05 0.5 C 1.05 0.31 1.21 0.15 1.4 0.15 Z",
              "stroke": "kraftEdge",
              "fill": "kraftDark",
              "width": 2
            },
            {
              "d": "M 1.0 0.8 C 1.19 0.8 1.35 0.96 1.35 1.15 C 1.35 1.34 1.19 1.5 1.0 1.5 C 0.81 1.5 0.65 1.34 0.65 1.15 C 0.65 0.96 0.81 0.8 1.0 0.8 Z",
              "stroke": "kraftEdge",
              "fill": "kraft",
              "width": 2
            }
          ],
          "caption": "Cut cardboard circles and wrap them in foil — instant treasure."
        }
      ],
      "instructions": [
        "Draw or paint wood planks on the box and lid — brown stripes with little dots for nails.",
        "Color the straps and hasp black or gold so they look like iron bands.",
        "Write your pirate name on the lid, or draw a skull and crossbones.",
        "Fill it with treasure: foil coins, shells, jewels — whatever your crew guards best."
      ],
      "tip": "Markers are faster than paint and never warp the cardboard."
    }
